{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arrow",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/m/*", "/"]
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
  // Secrets (not in this file): SUPABASE_SERVICE_KEY, DIAL_API_KEY, TYPESAFE_API_KEY. Optional vars: SUPABASE_URL, DIAL_FROM_NUMBER.
}
