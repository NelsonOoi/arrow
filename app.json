{
  "expo": {
    "name": "Arrow",
    "slug": "arrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arrow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.speedhacks.arrow",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Arrow uses Bluetooth to detect matched attendees who are physically near you.",
        "NSBluetoothPeripheralUsageDescription": "Arrow uses Bluetooth so matched attendees near you can detect you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.speedhacks.arrow",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "munim-bluetooth",
        {
          "androidBluetoothPermissions": [
            "scan",
            "connect",
            "advertise"
          ],
          "multipeerServiceTypes": false,
          "bluetoothAlwaysUsageDescription": "Arrow uses Bluetooth to detect matched attendees who are physically near you.",
          "bluetoothPeripheralUsageDescription": "Arrow uses Bluetooth so matched attendees near you can detect you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43ed2afc-0542-407d-b7c0-fd25d2ef09e6"
      }
    },
    "owner": "maketheswapp"
  }
}
