{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["yul1"],
  "framework": null,
  "installCommand": "npm ci --prefix web",
  "buildCommand": "",
  "outputDirectory": "web/public",
  "functions": {
    "api/mm.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env,.env.*,node_modules/**,web/**,src/**,assets/**,pitch/**,demo/**,tests/**,scripts/**,migrations/**,supabase/**,.expo/**,.hypothesis/**,.pytest_cache/**,ios/**,android/**}"
    },
    "api/web.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/mm/:path*", "destination": "/api/mm" },
    { "source": "/api/:path*", "destination": "/api/web" },
    { "source": "/m/:token", "destination": "/m.html" },
    { "source": "/", "destination": "/host.html" }
  ]
}
