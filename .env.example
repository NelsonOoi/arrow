# Hosted Supabase (demo). From uvicorn or scripts: the SESSION pooler (port 5432) or the direct connection.
# On Vercel (VERCEL=1), set DATABASE_URL to the TRANSACTION pooler (6543) instead; see README "Deploy (Vercel)".
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local Supabase CLI database (`npx supabase@2.118.0 start`), used by tests.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TYPESAFE_API_KEY=
# fake | jev
SCORER=fake
# When set, setup endpoints (create/import/precompute/live/refresh/bridge) need `Authorization: Bearer <HOST_KEY>`.
HOST_KEY=

# Expo app (inlined at bundle time; restart `npm start` after changing).
# Deployed: https://<project>.vercel.app/mm. On a LAN: your laptop's address, with uvicorn on --host 0.0.0.0.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# Optional: pin the app to one event. Unset, it uses the newest live event.
EXPO_PUBLIC_EVENT_ID=
